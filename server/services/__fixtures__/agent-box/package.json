{
  "name": "agent-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch src/server.ts",
    "dev:frontend": "vite --host 0.0.0.0 frontend",
    "build": "tsc -p tsconfig.server.json && vite build frontend",
    "build:server": "tsc -p tsconfig.server.json",
    "build:frontend": "vite build frontend",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mts"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "easymde": "^2.21.0",
    "express": "^4.21.2",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "openid-client": "^5.7.1",
    "react-markdown": "^10.1.0",
    "react-simplemde-editor": "^5.2.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/multer": "^2.1.0",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.19.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "jose": "^5.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "optionalDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
