# Copy to .env and fill in. See README.md for how to get these.

MJ_SALAI_TOKEN=
MJ_SERVER_ID=
MJ_CHANNEL_ID=

# Optional — defaults shown
# MJ_BOT_ID=mj
# MJ_REMIX=false
# MJ_DEBUG=false
# MJ_PREVIEW_MAX_EDGE=1024
# MJ_PREVIEW_QUALITY=82
# PORT=8901

# Required for /upload-reference — the public URL this bridge itself is
# reachable at (e.g. https://mj-bridge.example.com), so Midjourney's bot can
# fetch back the reference images it hands out.
MJ_PUBLIC_BASE_URL=

# Strongly recommended once this bridge is publicly reachable (needed for
# MJ_PUBLIC_BASE_URL above): protects /mcp and /upload-reference with a
# bearer token. Leave unset only if you're still LAN-only.
MJ_BRIDGE_TOKEN=
