# Copy to .env and fill in. See README.md for how to get these.

MJ_SALAI_TOKEN=
MJ_SERVER_ID=
MJ_CHANNEL_ID=

# Optional — defaults shown
# MJ_BOT_ID=mj
# MJ_REMIX=false
# MJ_DEBUG=false
# MJ_PREVIEW_MAX_EDGE=1024
# MJ_PREVIEW_QUALITY=82
# PORT=8901

# Recommended — protects /mcp with a bearer token. Leave unset to run open
# (fine only on a fully trusted private network).
MJ_BRIDGE_TOKEN=
